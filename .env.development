# 本地开发：让 src/lib/basePath.js 的 withBase() BASE_PATH
# 与 next.config.js 的 basePath 默认值(/XIAO_Landing_Page)保持一致。
# 否则 /home/*.webp、/xiao-products/* 等本地图片会因缺少子路径前缀而 404。
#
# 仅 next dev(NODE_ENV=development)加载本文件；
# next build(NODE_ENV=production)不加载，生产构建在 CI(deploy.yml)单独注入。
# fork 后直接 `npm install && npm run dev`，访问 http://localhost:3000/XIAO_Landing_Page/ 即可。
NEXT_PUBLIC_BASE_PATH=/XIAO_Landing_Page
